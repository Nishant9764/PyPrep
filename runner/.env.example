# Shared secret the API server must send as "Authorization: Bearer <secret>".
RUNNER_SECRET=change-me-to-a-long-random-string

# Where to listen. Use ONE of these:
#   RUNNER_PORT   - TCP (local development without Docker)
#   RUNNER_SOCKET - unix socket (Docker setup; the container then needs no network at all)
RUNNER_PORT=5001
#RUNNER_SOCKET=/run/runner/runner.sock
#RUNNER_SOCKET_GID=2000

# Privilege drop. Learner code runs as uid SANDBOX_UID_BASE+slot, never as the runner's user.
# 0 disables the drop (fine for local dev as a normal user; REQUIRED in production/Docker).
SANDBOX_UID_BASE=0

MAX_CONCURRENT=4          # parallel executions (one sandbox uid per slot)
MAX_QUEUE=40              # waiting jobs before the runner answers 503
MEMORY_LIMIT_MB=256       # per execution (RLIMIT_AS)
CPU_LIMIT_SECONDS=8       # per execution (RLIMIT_CPU)
WALL_LIMIT_SECONDS=10     # per execution, hard kill
PROCESS_LIMIT=32          # per sandbox uid (RLIMIT_NPROC) - stops fork bombs
