# ---- used by docker-compose.yml (copy to .env) -----------------------------------------------
# Generate each secret with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
RUNNER_SECRET=

# First administrator. Created at startup; this is who approves signups.
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Where you open the app. Must match exactly (scheme + host + port).
CLIENT_ORIGIN=http://localhost:8080
WEB_PORT=8080
# Set to true once you serve the site over HTTPS
COOKIE_SECURE=false
