NODE_ENV=development
PORT=4000

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/pyprep

# Long random string (>= 32 chars) used to sign login cookies.  Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-only-insecure-secret-change-me-please-0123456789
JWT_EXPIRES_DAYS=14

# The URL(s) the React app is served from, comma separated. Used for CORS and the CSRF origin check.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# true when the site is served over HTTPS (marks the login cookie "Secure")
COOKIE_SECURE=false
# Set to 1 when running behind a reverse proxy (so rate limiting sees real client IPs)
TRUST_PROXY=0

# First admin account, created (or promoted) automatically at startup. REQUIRED for the
# approval flow: signups wait for this account to approve them.
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe-Admin-123

# Code runner (separate service). Use ONE of the two connection styles.
RUNNER_SECRET=change-me-to-a-long-random-string
RUNNER_URL=http://127.0.0.1:5001
#RUNNER_SOCKET=/run/runner/runner.sock

# Where the curriculum files live (default: ../content relative to server/)
#CONTENT_DIR=../content

# Per-user rate limits for practice endpoints (raise only for automated tests)
#RUNS_PER_MINUTE=40
#SUBMITS_PER_MINUTE=25
#SIGNUPS_PER_HOUR=10
#LOGINS_PER_15_MIN=20
